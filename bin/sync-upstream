#!/usr/bin/env bash
set -e

# Sync script to pull upstream updates and integrate into custom-main

MODE="merge"
UPSTREAM_REMOTE="upstream"
UPSTREAM_BRANCH="master"
TARGET_BRANCH="custom-main"

print_usage() {
  echo "Usage: $0 [options] [upstream-branch]"
  echo ""
  echo "Options:"
  echo "  -m, --merge    Merge upstream changes into $TARGET_BRANCH (default)"
  echo "  -r, --rebase   Rebase $TARGET_BRANCH onto upstream changes"
  echo "  -h, --help     Show this help message"
  echo ""
  echo "Arguments:"
  echo "  upstream-branch   Upstream branch to sync from (default: $UPSTREAM_BRANCH)"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--merge)
      MODE="merge"
      shift
      ;;
    -r|--rebase)
      MODE="rebase"
      shift
      ;;
    -h|--help)
      print_usage
      exit 0
      ;;
    *)
      if [[ "$1" != -* ]]; then
        UPSTREAM_BRANCH="$1"
        shift
      else
        echo "Unknown option: $1" >&2
        print_usage
        exit 1
      fi
      ;;
  esac
done

echo "=== Syncing with upstream ($UPSTREAM_REMOTE/$UPSTREAM_BRANCH) ==="

# 1. Check if git repo has uncommitted changes
if ! git diff-index --quiet HEAD --; then
  echo "❌ Error: Working tree has uncommitted changes." >&2
  echo "Please commit, stash ('git stash'), or discard them before syncing." >&2
  exit 1
fi

# 2. Fetch all latest upstream branches and tags
echo "Fetching updates and tags from $UPSTREAM_REMOTE..."
git fetch "$UPSTREAM_REMOTE" --tags --prune

# 3. Ensure clean local tracking branch exists and fast-forward it
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if [ "$CURRENT_BRANCH" != "$UPSTREAM_BRANCH" ]; then
  echo "Updating clean local tracking branch '$UPSTREAM_BRANCH'..."
  if git show-ref --verify --quiet "refs/heads/$UPSTREAM_BRANCH"; then
    git fetch "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH:$UPSTREAM_BRANCH"
  else
    git branch "$UPSTREAM_BRANCH" "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"
  fi
fi

# 4. Switch to target branch if not already on it
if [ "$CURRENT_BRANCH" != "$TARGET_BRANCH" ]; then
  echo "Switching to $TARGET_BRANCH..."
  git checkout "$TARGET_BRANCH"
fi

# 5. Integrate upstream changes
echo "Integrating $UPSTREAM_REMOTE/$UPSTREAM_BRANCH into $TARGET_BRANCH using $MODE..."

if [ "$MODE" = "merge" ]; then
  if git merge "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"; then
    echo ""
    echo "✅ Successfully merged $UPSTREAM_REMOTE/$UPSTREAM_BRANCH into $TARGET_BRANCH!"
  else
    echo ""
    echo "⚠️  CONFLICT DETECTED DURING MERGE!" >&2
    echo "Conflicting files:" >&2
    git diff --name-only --diff-filter=U | sed 's/^/  - /' >&2
    echo "" >&2
    echo "Next steps to resolve:" >&2
    echo "  1. Open each conflicting file and resolve conflict markers (<<<<<<<, =======, >>>>>>>)." >&2
    echo "  2. Mark resolved files: git add <file>" >&2
    echo "  3. Complete the merge:  git commit" >&2
    echo "  (To abort the merge:    git merge --abort)" >&2
    exit 1
  fi
elif [ "$MODE" = "rebase" ]; then
  if git rebase "$UPSTREAM_REMOTE/$UPSTREAM_BRANCH"; then
    echo ""
    echo "✅ Successfully rebased $TARGET_BRANCH onto $UPSTREAM_REMOTE/$UPSTREAM_BRANCH!"
  else
    echo ""
    echo "⚠️  CONFLICT DETECTED DURING REBASE!" >&2
    echo "Conflicting files:" >&2
    git diff --name-only --diff-filter=U | sed 's/^/  - /' >&2
    echo "" >&2
    echo "Next steps to resolve:" >&2
    echo "  1. Open each conflicting file and resolve conflict markers (<<<<<<<, =======, >>>>>>>)." >&2
    echo "  2. Mark resolved files: git add <file>" >&2
    echo "  3. Continue the rebase: git rebase --continue" >&2
    echo "  (To abort the rebase:   git rebase --abort)" >&2
    exit 1
  fi
fi

echo ""
echo "To push updated $TARGET_BRANCH to your GitHub fork:"
if [ "$MODE" = "rebase" ]; then
  echo "  git push --force-with-lease origin $TARGET_BRANCH"
else
  echo "  git push origin $TARGET_BRANCH"
fi
